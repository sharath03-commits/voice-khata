# Copy this file to backend/.env and edit. Never commit the real .env.

# ---- Owner login (mobile OTP)
VK_REQUIRE_AUTH=true
# Only this number can log in. If empty, the phone saved in Store details is used.
VK_OWNER_PHONE=
# Demo mode: shows the OTP on screen when SMS isn't configured. Set false for a real shop.
VK_ALLOW_DEV_OTP=true
# true only when the app is served over https
VK_COOKIE_SECURE=false

# ---- Customer SMS (Twilio). Leave blank to run without SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Own voice assistant models (defaults shown; change only if needed)
# VK_STT_KN=vasista22/whisper-kannada-small
# VK_STT_HI=vasista22/whisper-hindi-small
# VK_STT_EN=openai/whisper-base
# VK_STT_WAKE=openai/whisper-tiny
# VK_TTS_KN=facebook/mms-tts-kan
# VK_TTS_HI=facebook/mms-tts-hin
# VK_TTS_EN=facebook/mms-tts-eng

# ---- Optional database location
# VK_DB=/absolute/path/to/voice_khata.db
