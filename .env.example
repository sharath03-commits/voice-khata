# Owner API authentication (enabled by default)
VK_REQUIRE_AUTH=true
VK_COOKIE_SECURE=true
VK_ALLOW_DEV_OTP=false

# Twilio Programmable Messaging - configure on the server only
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-secret
TWILIO_FROM=+1xxxxxxxxxx

# Optional database override
# VK_DB=/absolute/path/to/voice_khata.db
